{
  "name": "shrike-mcp",
  "mcpName": "io.github.Shrike-Security/shrike-mcp",
  "version": "4.0.2",
  "description": "MCP server for action governance on AI agents — 14 tools that govern tool calls, SQL queries, file writes, shell commands, and agent-to-agent messages server-side, before execution. Allow / approve / block. Session correlation. Works with Claude Desktop, Cursor, Windsurf, and any MCP client.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "shrike-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "action-governance",
    "ai-agents",
    "agent-governance",
    "agent-security",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude-desktop",
    "cursor",
    "windsurf",
    "cline",
    "tool-call-gating",
    "ai-governance",
    "ai-security",
    "prompt-injection",
    "session-correlation"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Shrike Security",
    "email": "support@shrikesecurity.com",
    "url": "https://shrikesecurity.com"
  },
  "homepage": "https://shrikesecurity.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shrike-Security/shrike-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Shrike-Security/shrike-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@google-cloud/secret-manager": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  }
}
